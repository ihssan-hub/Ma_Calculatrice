<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="@color/bg_dark_plum">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Connexion"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="@color/pink_accent"
        android:layout_marginBottom="40dp" />

    <!-- Champ Login avec AutoCompleteTextView -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:boxStrokeColor="@color/pink_primary"
        app:hintTextColor="@color/mauve_light"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

        <AutoCompleteTextView
            android:id="@+id/etLogin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Login"
            android:textColor="#FFFFFF"
            android:textColorHint="@color/pink_light" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Champ Mot de passe avec TextInputEditText -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        app:endIconMode="password_toggle"
        app:endIconTint="@color/pink_accent"
        app:boxStrokeColor="@color/pink_primary"
        app:hintTextColor="@color/mauve_light"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Mot de passe"
            android:inputType="textPassword"
            android:textColor="#FFFFFF"
            android:textColorHint="@color/pink_light" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Bouton de connexion -->
    <Button
        android:id="@+id/btnLogin"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Se connecter"
        android:backgroundTint="@color/pink_primary"
        android:textColor="#FFFFFF"
        android:textSize="18sp" />

</LinearLayout>